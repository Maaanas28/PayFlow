# ==========================================
# PayFlow Backend Environment Configuration
# ==========================================

# Server Configuration
# Render automatically injects PORT and sets HOST
PORT=4000
HOST=0.0.0.0
NODE_ENV=production

# Database Configuration (PostgreSQL)
# On Render: Auto-populated via Blueprint from Database connectionString,
# or manually copied from the Render PostgreSQL "Internal Database URL".
# Local: postgresql://payflow_user:payflow_password@localhost:5432/payflow_db?schema=public
DATABASE_URL="postgresql://payflow_user:payflow_password@localhost:5432/payflow_db?schema=public"

# CORS Configuration
# Comma-separated list of allowed origins. In production, provide your Render frontend URL:
# e.g., https://payflow-frontend.onrender.com,http://localhost:5173
CORS_ORIGIN="http://localhost:5173"

# Webhooks Configuration
# A secure random secret used to sign outgoing sandbox webhooks with HMAC-SHA256.
# On Render: auto-generated via Blueprint (generateValue: true) or generate a 32+ char secret.
WEBHOOK_SECRET="whsec_sandbox_secret_key_12345"

# Optional default webhook destination URL for event dispatching
WEBHOOK_DEFAULT_URL=""
